# ── Large raw data: NEVER commit (videos are ~25 GB total) ──
*.mp4
*.avi
*.mov
*.mkv
*.seq
*.ts

# Extracted frames and clips (regenerable, large)
data/raw/
data/frames/
data/clips/
_sample_frames/
_docx_media/
*.png
*.jpg
*.jpeg
# but DO allow small docs/diagram images if ever needed:
!docs/**/*.png
# Team-facing deliverables ARE tracked (small demo media), despite the rules above:
!results/
!results/**

# Annotations export dumps can be large; keep curated ones explicitly
data/annotations_raw/

# Generated review contact sheets reference local (git-ignored) thumbnails
data/events/review/

# Annotation workspace: keep the corrected LABELS + index (precious, small), but not
# the extracted frame PNGs (regenerable, large — already excluded by *.png).
# Run logs:
data/**/_*_log.txt
data/_*_log.txt

# ── Model artifacts ──
*.pt
*.onnx
*.engine
runs/
weights/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ── OS / editor ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Secrets ──
*.pem
*.key
deploy_key*
id_*
.env

# build/run logs
*.log

# unverified harvest staging (pre-labels) — merge into labels/ after verifying
data/annotate/harvest/

# mmdetection COCO pretrained checkpoints — 1.1 GB of re-downloadable public
# weights. GitHub hard-rejects any blob >100 MB, and *.pt above did not cover .pth.
*.pth
weights_mmdet/

# Paper and email deliverables are small and hand-picked, and losing them means
# re-running GPU jobs to regenerate. Exempt them from the blanket *.jpg rule above.
!docs/figures/**/*.jpg
!docs/email_figures/*.jpg

# Overleaf upload bundle — regenerate with: cd overleaf_WACV && zip -r ../overleaf_WACV.zip .
overleaf_WACV.zip
wacv-2027-author-kit-template.zip

# LOSO fold datasets: ~50k symlinks each, regenerated by scripts/delta_loso.sbatch.
# Without this, git add -A stalls scanning them.
data/dataset/loso_*/

# Manuscript figures. Small, hand-picked, and several (the 2x2 qualitative composite,
# the pipeline diagram) are not regenerable by any script in this repo — losing them
# means rebuilding them by hand. Exempt from the blanket *.png / *.jpg rules above.
!overleaf_WACV/figures/**/*.png
!overleaf_WACV/figures/**/*.jpg
!overleaf_MDPI/figures/**/*.png
!overleaf_MDPI/figures/**/*.jpg

# MDPI class package as shipped by the publisher, plus the upload bundle.
overleaf_MDPI.zip
# (gitignore has no quoting -- match the publisher zip by glob instead)
MDPI_template_ACS*.zip
